# Google AdSense
# El ID de editor (ca-pub-7190127104678764) ya está puesto por defecto en
# components/AdSenseLoader.tsx, así que no hace falta configurar esta
# variable salvo que quieras usar una cuenta de AdSense distinta:
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Crea unidades de anuncio en el panel de AdSense y sustituye los IDs de
# ejemplo ("0000000001", "0000000002"...) en los componentes <AdSlot />
# (por ejemplo en components/sections/GlossarySection.tsx) por los
# data-ad-slot reales de cada unidad.

# Google Analytics (GA4)
# Crea una propiedad en https://analytics.google.com y copia el ID de
# medición (formato G-XXXXXXXXXX) aquí:
NEXT_PUBLIC_GA_MEASUREMENT_ID=
